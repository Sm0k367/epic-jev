{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "AI_GATEWAY_API_KEY": "@ai_gateway_api_key"
  },
  "buildCommand": "npm ci",
  "devCommand": "npm start"
}
