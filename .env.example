# Epic Jev — Environment Configuration
#
# Every value below is OPTIONAL. With none set, the app runs fully in demo
# mode: decisions come from a deterministic local simulator and generated apps
# use a built-in fallback. Nothing breaks without credentials — they only
# switch the app from simulated to real models.
#
# No secret is ever hardcoded in source, the client bundle, or logs.

# ── Decision engine: Clef (Cloudflare Workers AI) ───────────────────────────
# Clef is the fastest, highest-scoring decision model (38ms median, multimodal).
# Both values are required together to enable it.
#   Account ID: dash.cloudflare.com → right sidebar → "Account ID"
#   API token:  dash.cloudflare.com → My Profile → API Tokens → Create Token
#               (template: "Workers AI" → Edit)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_AUTH_TOKEN=your_workers_ai_token_here

# ── Decision engine + generation: Vercel AI Gateway ─────────────────────────
# One key enables BOTH:
#   • Jev decision model (typesafe-ai/jev) as a Clef alternative
#   • Text generation (summarization, data extraction)
#   • Code generation (the App Builder)
# Get a key: https://vercel.com/dashboard/ai-gateway/keys
AI_GATEWAY_API_KEY=your_gateway_key_here

# ── Optional model / engine overrides ───────────────────────────────────────
# Force a specific decision engine instead of auto-selecting.
# Auto order when unset: clef-flash (if Cloudflare creds) → jev (if Gateway
# key) → demo. A requested engine whose credentials are absent is ignored and
# falls back to the configured engine (never sends an unauthenticated call).
#   Options: clef | clef-flash | jev | laya | demo
#DECISION_ENGINE=clef-flash

# Text model for summarization/extraction (default: openai/gpt-oss-20b).
# Must be a model id returned by https://ai-gateway.vercel.sh/v1/models
#AI_GATEWAY_TEXT_MODEL=openai/gpt-oss-20b

# Code model for the App Builder (default: poolside/laguna-s-2.1-free, $0).
#AI_GATEWAY_MODEL=poolside/laguna-s-2.1-free

# ── Server ──────────────────────────────────────────────────────────────────
# Port (defaults to 3000; Vercel sets this automatically).
PORT=3000
